# Copy to .env and fill in. Never commit .env.
#
# The app runs with NO key via the record/replay fixture provider
# (docs/adr/0004-record-replay-provider.md). A key is only needed to
# re-record fixtures or to get real semantic matching on novel input.

# Google AI Studio key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model IDs. Never hard-coded in source; see docs/adr/0001-llm-provider.md.
# Strong tier defaults to stable Flash because the current Pro is preview-only.
GEMINI_MODEL_FAST=gemini-3.8-flash
GEMINI_MODEL_STRONG=gemini-3.8-flash
GEMINI_MODEL_EMBED=gemini-embedding-001

# Embedding dimension. Confirmed at fixture-record time, not assumed.
EMBED_DIM=3072

# 'replay' (default, no key needed) or 'gemini'
AI_PROVIDER=replay

# SQLite file. Gitignored.
DATABASE_URL=./data/fis.db
