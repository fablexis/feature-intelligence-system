# Copy to .env and fill in. Never commit .env.
#
# The app runs with NO key via the record/replay fixture provider
# (docs/adr/0004-record-replay-provider.md). A key is only needed to
# re-record fixtures or to get real semantic matching on novel input.

# Google AI Studio key — https://aistudio.google.com/apikey
# This exact name is what the Vercel AI SDK's Google provider reads by default,
# so the SDK picks it up without the app ever handling the value.
GOOGLE_GENERATIVE_AI_API_KEY=

# Model IDs. Never hard-coded in source; see docs/adr/0001-llm-provider.md.
#
# The free tier caps generate_content at a small number of requests PER DAY,
# PER MODEL (20/day measured on gemini-3.8-flash). So each stage gets its own
# model, and therefore its own quota bucket: one exhausted cap can then stall
# at most one stage. Run `npm run record -- --dry-run` for the budget table.
GEMINI_MODEL_FAST=gemini-3.1-flash-lite
GEMINI_MODEL_EMBED=gemini-embedding-001

# Fallback for the two below; set them individually to spread the load.
GEMINI_MODEL_STRONG=gemini-3.5-flash-lite
# Largest consumer (~44 calls), so it gets an untouched bucket.
GEMINI_MODEL_ADJUDICATE=gemini-3.5-flash-lite
# Smallest after batching (3 calls), so it can sit on the known-20/day model.
GEMINI_MODEL_SCORE=gemini-3.8-flash

# Embedding dimension, requested via outputDimensionality. 768 rather than the
# 3072 maximum: a quarter the fixture size, and ample at a 12-problem scale.
EMBED_DIM=768

# 'replay' (default, no key needed) or 'gemini'
AI_PROVIDER=replay

# Record-script quota guards. Free-tier limits are not published (ADR 0001),
# so these default low; raise them if your project's limits allow.
RECORD_RPM=20
EMBED_BATCH_SIZE=16

# SQLite file. Gitignored.
DATABASE_URL=./data/fis.db
